depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.0"}
  "yojson"
  "lwt"
  "dream"
  "brr"
  "js_of_ocaml"
  "js_of_ocaml-lwt"
  "cohttp-lwt-unix"
  "lambdasoup"
  "ounit2" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
